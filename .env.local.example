# ============================================================
# Nedcloud Website — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in real values:
#   cp .env.local.example .env.local
#
# NEVER commit .env.local to git (already in .gitignore)
# ============================================================

# ---------------------
# Database
# ---------------------
DB_USER=nedcloud
DB_PASSWORD=change_me_in_production
DB_NAME=nedcloud
DB_PORT=5432

# Full database URL (used by Prisma at runtime and by prisma.config.ts for client generation)
# Dev (local DB in Docker):  host = localhost
# Docker Compose (containers): host = postgres
DATABASE_URL=postgresql://nedcloud:change_me_in_production@localhost:5432/nedcloud

# ---------------------
# NextAuth
# ---------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_secure_random_string
NEXTAUTH_URL=http://localhost:3000

# ---------------------
# Admin User (for database seeding)
# ---------------------
# These are used when running: npx prisma db seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_strong_password

# ---------------------
# Optional Ports
# ---------------------
# Override only if defaults conflict with other services
# APP_PORT=3000
# STUDIO_PORT=5555

# ============================================================
# Deployment Notes
# ============================================================
#
# LOCAL DEVELOPMENT:
#   1. cp .env.local.example .env.local
#   2. docker compose -f docker-compose.dev.yml up -d   (starts PostgreSQL)
#   3. npx prisma migrate dev                            (create tables)
#   4. npm run dev                                       (start Next.js)
#
# DOCKER COMPOSE (PRODUCTION):
#   1. Build args are passed via docker-compose.yml environment section
#   2. DATABASE_URL host must be 'postgres' (not 'localhost') inside containers
#   3. Run migrations: docker compose --profile migrate run --rm migrate
#   4. Start services:  docker compose up -d
#
# PRISMA CLIENT GENERATION:
#   prisma.config.ts uses dotenv to read DATABASE_URL from .env.local
#   This is required for `npx prisma generate` and `npx prisma migrate` to work