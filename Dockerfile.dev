# Dockerfile for Development
FROM node:20-slim

# Use existing node user (UID 1000) - don't create new users
# The node:20-slim image already has a 'node' user with UID 1000

WORKDIR /app

RUN apt-get update && apt-get install -y libc6 openssl && rm -rf /var/lib/apt/lists/*

# Copy and install as root first
COPY package.json package-lock.json* ./
RUN npm ci

COPY prisma/schema.prisma ./
RUN npx prisma generate

# Now copy everything and set ownership to node user (UID 1000)
COPY . .
RUN chown -R node:node /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000

# Switch to node user (UID 1000) - matches host user for volume permissions
USER node

CMD ["npm", "run", "dev"]
